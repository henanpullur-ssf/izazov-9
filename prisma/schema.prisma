generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String                @id @default(cuid())
  name              String
  email             String                @unique
  phone             String?
  passwordHash      String?
  role              UserRole              @default(PARTICIPANT)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  checkedAttendance Attendance[]          @relation("AttendanceCheckedBy")
  coordinatedEvents EventCoordinator[]
  judge             Judge?
  participant       Participant?
  volunteer         Volunteer?
  volunteerTasks    VolunteerAssignment[]

  @@index([role])
}

model Participant {
  id            String                    @id @default(cuid())
  participantId String                    @unique
  userId        String?                   @unique
  name          String
  gender        String?
  dateOfBirth   DateTime?
  phone         String?
  email         String?
  address       String?
  photoUrl      String?
  qrToken       String                    @unique @default(cuid())
  houseId       String?
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  attendance    Attendance[]
  house         House?                    @relation(fields: [houseId], references: [id])
  user          User?                     @relation(fields: [userId], references: [id])
  registrations RegistrationParticipant[]
  results       Result[]

  @@index([name])
  @@index([houseId])
}

model House {
  id           String        @id @default(cuid())
  name         String        @unique
  shortName    String?
  description  String?
  logoUrl      String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  participants Participant[]
}

model Event {
  id                   String                @id @default(cuid())
  code                 String                @unique
  name                 String
  description          String?
  category             String?
  type                 EventType             @default(INDIVIDUAL)
  status               EventStatus           @default(DRAFT)
  maxParticipants      Int?
  durationMinutes      Int?
  venueId              String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  attendance           Attendance[]
  venue                Venue?                @relation(fields: [venueId], references: [id])
  coordinators         EventCoordinator[]
  judges               JudgeAssignment[]
  registrations        Registration[]
  results              Result[]
  schedules            Schedule[]
  scores               Score[]
  volunteerAssignments VolunteerAssignment[]

  @@index([status])
  @@index([category])
  @@index([venueId])
}

model EventCoordinator {
  id        String   @id @default(cuid())
  eventId   String
  userId    String
  createdAt DateTime @default(now())
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId])
}

model Registration {
  id                 String                    @id @default(cuid())
  registrationNumber String                    @unique
  eventId            String
  status             RegistrationStatus        @default(PENDING)
  teamName           String?
  registeredAt       DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  event              Event                     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  participants       RegistrationParticipant[]
  results            Result[]
  scores             Score[]

  @@index([eventId])
  @@index([status])
}

model RegistrationParticipant {
  id             String       @id @default(cuid())
  registrationId String
  participantId  String
  createdAt      DateTime     @default(now())
  participant    Participant  @relation(fields: [participantId], references: [id], onDelete: Cascade)
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@unique([registrationId, participantId])
  @@index([participantId])
}

model Venue {
  id          String     @id @default(cuid())
  name        String     @unique
  location    String?
  description String?
  capacity    Int?
  imageUrl    String?
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  events      Event[]
  schedules   Schedule[]
}

model Schedule {
  id        String   @id @default(cuid())
  eventId   String
  venueId   String?
  startTime DateTime
  endTime   DateTime
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  venue     Venue?   @relation(fields: [venueId], references: [id])

  @@index([eventId])
  @@index([venueId])
  @@index([startTime])
}

model Volunteer {
  id          String                @id @default(cuid())
  userId      String                @unique
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignments VolunteerAssignment[]
}

model VolunteerAssignment {
  id           String    @id @default(cuid())
  volunteerId  String
  userId       String
  eventId      String?
  duty         String?
  venueId      String?
  checkedInAt  DateTime?
  checkedOutAt DateTime?
  createdAt    DateTime  @default(now())
  event        Event?    @relation(fields: [eventId], references: [id])
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  volunteer    Volunteer @relation(fields: [volunteerId], references: [id], onDelete: Cascade)

  @@index([volunteerId])
  @@index([eventId])
}

model Judge {
  id           String            @id @default(cuid())
  userId       String            @unique
  designation  String?
  organization String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignments  JudgeAssignment[]
  scores       Score[]
}

model JudgeAssignment {
  id        String   @id @default(cuid())
  judgeId   String
  eventId   String
  createdAt DateTime @default(now())
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  judge     Judge    @relation(fields: [judgeId], references: [id], onDelete: Cascade)

  @@unique([judgeId, eventId])
  @@index([eventId])
}

model Score {
  id             String       @id @default(cuid())
  eventId        String
  registrationId String
  judgeId        String
  marks          Decimal      @db.Decimal(6, 2)
  maxMarks       Decimal      @db.Decimal(6, 2)
  remarks        String?
  status         ScoreStatus  @default(DRAFT)
  submittedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  event          Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  judge          Judge        @relation(fields: [judgeId], references: [id], onDelete: Cascade)
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@unique([registrationId, judgeId])
  @@index([eventId])
  @@index([judgeId])
}

model Attendance {
  id            String           @id @default(cuid())
  participantId String
  eventId       String
  checkedById   String?
  status        AttendanceStatus @default(PRESENT)
  scannedAt     DateTime         @default(now())
  notes         String?
  checkedBy     User?            @relation("AttendanceCheckedBy", fields: [checkedById], references: [id])
  event         Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  participant   Participant      @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([participantId, eventId])
  @@index([eventId])
  @@index([participantId])
}

model Result {
  id             String       @id @default(cuid())
  eventId        String
  registrationId String
  participantId  String?
  position       Int?
  totalMarks     Decimal      @db.Decimal(8, 2)
  isWinner       Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  event          Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  participant    Participant? @relation(fields: [participantId], references: [id])
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([registrationId])
  @@index([participantId])
}

model Announcement {
  id          String               @id @default(cuid())
  title       String
  content     String
  priority    AnnouncementPriority @default(NORMAL)
  isPublished Boolean              @default(false)
  isPinned    Boolean              @default(false)
  publishedAt DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([isPublished])
  @@index([isPinned])
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  action      String
  entity      String?
  entityId    String?
  description String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([entity])
  @@index([createdAt])
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  COORDINATOR
  VOLUNTEER
  JUDGE
  PARTICIPANT
}

enum EventType {
  INDIVIDUAL
  GROUP
}

enum EventStatus {
  DRAFT
  UPCOMING
  LIVE
  COMPLETED
  CANCELLED
}

enum RegistrationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  DISQUALIFIED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
}

enum AnnouncementPriority {
  NORMAL
  IMPORTANT
  URGENT
}

enum ScoreStatus {
  DRAFT
  SUBMITTED
  LOCKED
}
